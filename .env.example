NEXT_PUBLIC_APP_NAME="Kampus Konnect AI"

# Your deployed URL — set this in Vercel dashboard (e.g. https://kampuskonnect.vercel.app)
NEXT_PUBLIC_APP_URL="https://your-deployed-url.vercel.app"

# Google Gemini API key — server-only, never prefix with NEXT_PUBLIC_
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase — public keys are safe to expose, service role key is server-only
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
